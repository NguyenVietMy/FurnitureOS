# Published glTF documents are byte-accounted assets. Preserve their exact
# repository bytes on every platform instead of applying text EOL conversion.
public/products/**/*.gltf -text
public/products/**/asset-manifest.json -text
public/products/**/*.bin -text
public/products/**/*.ktx2 -text
# Living review/promotion binds exact metadata bytes as well as runtime files.
api/catalogue/providers/abo-living-candidates.json -text
api/catalogue/providers/abo-living-reviewed.json -text
# Content-addressed expansion records and their index are raw-byte pinned.
api/catalogue/providers/expansion/*.json -text
