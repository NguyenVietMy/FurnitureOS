{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "esModuleInterop": true, "types": ["node"]
  },
  "include": ["ui/**/*.ts", "ui/**/*.tsx", "tests/**/*.ts", "playwright.config.ts"]
}
