{
  "name": "furnitureos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "predev": "node scripts/copy-decoders.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-catalogue-manifests.mjs && node scripts/copy-decoders.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "uv run uvicorn api.main:app --host 127.0.0.1 --port 8000",
    "start:full": "npm run build && uv run uvicorn api.main:app --host 127.0.0.1 --port 8000",
    "api:types": "uv run python scripts/generate_api_types.py",
    "api:types:check": "uv run python scripts/generate_api_types.py --check",
    "typecheck": "npm run api:types:check && tsc --noEmit",
    "test": "vitest",
    "pretest:e2e": "node scripts/copy-decoders.mjs",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-e2e.ps1",
    "assets:build": "node scripts/build-product-assets.mjs",
    "assets:report": "node scripts/report-asset-budget.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.5",
    "@types/three": "0.185.0",
    "@vitejs/plugin-react": "6.1.1",
    "gltfpack": "1.2.0",
    "meshoptimizer": "^1.2.0",
    "start-server-and-test": "3.0.12",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
